      "type": "string",
      "description": "The unique identifier of the member whose savings balance is to be retrieved.",
      "required": true,
      "sensitivity": "internal",
      "pattern": "^\\d{6}$",
      "minLength": 6,
      "maxLength": 6,
      "example": "123456"
    }
  ],
  "outputs": [
    {

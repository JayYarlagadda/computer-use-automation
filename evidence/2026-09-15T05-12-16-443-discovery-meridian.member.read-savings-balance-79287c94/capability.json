          ],
          "strategies": [
            {
              "kind": "anchor",
              "role": "cell",
              "rowText": "Savings",
              "match": "contains",
              "namePattern": "^[$£€]?\\s*[\\d,]+\\.\\d{2}$"
            }
          ],
          "notes": "Verified against the recorded screen: anchor: cell in the \"Savings\" row matching ^[$£€]?\\s*[\\d,]+\\.\\d{2}$. Rejected: role+name on cell (this control is being read, so its own text is the value -- a locator quoting it would only match the run it was recorded from); anchor: cell under \"Share Accounts\" matching ^[$£€]?\\s*[\\d,]+\\.\\d{2}$ (matched 3 controls on the recorded screen); structural: cell #21 (ordinal rungs are not emitted for extraction -- a wrong position returns a wrong value silently)."
        },
        "transforms": [
          "trim",
          "strip-currency"
        ]
      }
    }
  ],

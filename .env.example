# Copy to .env and fill in. Never commit .env.
#
# Put the key in .env, never in this file -- this one is tracked. The safest
# way to add a key is `npm run set-key`, which writes .env without echoing.
#
# Only ONE provider key is required. The discovery loop picks the provider
# named by LLM_PROVIDER; replay never calls a model at all, so the replay
# demo path in the README works with no key set.

LLM_PROVIDER=groq               # groq | openai
LLM_MODEL=openai/gpt-oss-120b

# Groq speaks the OpenAI wire format, so it is the OpenAI client pointed at a
# different base URL rather than a fourth SDK. Tool calling is required: the
# discovery loop hands the model a typed action vocabulary rather than parsing
# prose out of a completion.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Credentials for the local mock back-office. Fake, for a fake bank, and
# printed on its own sign-on screen. They live here rather than in an artifact
# because a capability records the *name* of a secret, never its value -- which
# is what makes a sign-on flow safe to commit to a public repository.
MERIDIAN_OPERATOR_ID=operator
MERIDIAN_OPERATOR_PASSWORD=demo1234

# Target app (local mock legacy back-office). Two ports = two "tenants"
# running the same vendor product with different branding/config.
MERIDIAN_PORT=4173
MERIDIAN_TENANT_B_PORT=4174

# Operator console for human-in-the-loop takeover.
OPERATOR_PORT=4180

# Run the browser headed so a human can physically take over the session.
# Tests force headless themselves. `--headless` on a command does the same.
HEADLESS=false

# Copy to .env and fill in. Never commit .env.
#
# Only ONE provider key is required. The discovery loop picks the provider
# named by LLM_PROVIDER; replay never calls an LLM at all, so the replay
# demo path in the README works with no key set.

LLM_PROVIDER=anthropic          # anthropic | openai | gemini | mock
LLM_MODEL=claude-sonnet-4-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Target app (local mock legacy back-office). Two ports = two "tenants"
# running the same vendor product with different branding/config.
MERIDIAN_PORT=4173
MERIDIAN_TENANT_B_PORT=4174

# Operator console for human-in-the-loop takeover.
OPERATOR_PORT=4180

# Run the browser headed so a human can physically take over the session.
HEADLESS=false
